# Optional: you can instead run `modelspend keys set <provider>` (stored in ~/.modelspend/keys.env, chmod 600).
# Real environment variables always override saved keys. Never commit real keys; ModelSpend never writes them to SQLite or logs.
# Load this file with:  modelspend --env-file .env <command>
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
GEMINI_API_KEY=your-gemini-key        # GOOGLE_API_KEY is also accepted
XAI_API_KEY=your-xai-key

# Explicit provider allowlist used when a request does not name providers (required for routing).
MODELSPEND_PROVIDERS=anthropic,openai
# Providers you approve for requests marked sensitive=true (empty = none).
MODELSPEND_SENSITIVE_PROVIDERS=

# Server. Loopback by default; any other bind address REQUIRES a token.
MODELSPEND_HOST=127.0.0.1
MODELSPEND_PORT=8787
MODELSPEND_API_TOKEN=

# Storage / catalog (defaults shown)
# MODELSPEND_HOME=~/.modelspend
# MODELSPEND_DB=~/.modelspend/modelspend.db
# MODELSPEND_OVERRIDES=~/.modelspend/overrides.json
# MODELSPEND_CATALOG=/path/to/custom-catalog.json

# Override a provider's official pricing page URL (default lives in sources.json; or: modelspend sources set <provider> <url>)
# MODELSPEND_PRICING_URL_OPENAI=https://developers.openai.com/api/docs/pricing

# Extra Host names the local server may be reached by (comma-separated), e.g. behind a reverse proxy on your LAN
# MODELSPEND_ALLOWED_HOSTS=modelspend.lan

# Policy knobs
MODELSPEND_MAX_PRICING_AGE_DAYS=30
MODELSPEND_EXCLUDE_STALE_PRICING=false
MODELSPEND_ALLOW_PREVIEW=false
MODELSPEND_EXACT_TOKEN_COUNTS=false
MODELSPEND_CLASSIFIER_MODEL=false     # optional cheap-model classifier for ambiguous prompts only
MODELSPEND_ALLOW_UNPRICED=false      # run models without a catalog price (cost shown as unknown; tokens still tracked)
